#!/usr/bin/env python3
"""glts - control and watch the Georgian transliteration bridge.

    glts on        register the display hook in Claude Code settings
    glts off       remove it again
    glts status    show whether the bridge and the trace are running
    glts watch     follow every conversion live, until Ctrl+C
    glts try TEXT  convert one line without touching anything
    glts latin F   print a Georgian file in Latin; --exact keeps it reversible
    glts kartuli F print a Latin file back as Georgian, for writing documents
"""

import importlib.machinery
import importlib.util
import json
import os
import signal
import sys
import time

# realpath, not abspath: the CLI is normally reached through a symlink on PATH.
HERE = os.path.dirname(os.path.realpath(__file__))
HOOK = os.path.join(HERE, "glts-hook")
SETTINGS = os.path.join(
    os.environ.get("CLAUDE_CONFIG_DIR") or os.path.expanduser("~/.claude"), "settings.json"
)

# The hook has no .py suffix, so it needs an explicit source loader.
_loader = importlib.machinery.SourceFileLoader("glts_hook", HOOK)
_spec = importlib.util.spec_from_loader("glts_hook", _loader)
_hook = importlib.util.module_from_spec(_spec)
_loader.exec_module(_hook)

STATE_DIR = _hook.STATE_DIR
TRACE_FLAG = _hook.TRACE_FLAG
TRACE_LOG = _hook.TRACE_LOG

BOLD = "\033[1m"
DIM = "\033[2m"
CYAN = "\033[36m"
GREEN = "\033[32m"
RESET = "\033[0m"


def load_settings():
    try:
        with open(SETTINGS) as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return {}


def save_settings(settings):
    os.makedirs(os.path.dirname(SETTINGS), exist_ok=True)
    with open(SETTINGS, "w") as fh:
        json.dump(settings, fh, indent=2, ensure_ascii=False)
        fh.write("\n")


def entries(settings):
    return settings.get("hooks", {}).get("MessageDisplay", [])


def is_registered(settings):
    for entry in entries(settings):
        for hook in entry.get("hooks", []):
            if hook.get("command") == HOOK:
                return True
    return False


def cmd_on():
    settings = load_settings()
    if is_registered(settings):
        print("glts is already registered in %s" % SETTINGS)
        return 0
    hooks = settings.setdefault("hooks", {})
    hooks.setdefault("MessageDisplay", []).append(
        {"hooks": [{"type": "command", "command": HOOK}]}
    )
    save_settings(settings)
    print("glts registered in %s" % SETTINGS)
    print("restart Claude Code for it to take effect")
    return 0


def cmd_off():
    settings = load_settings()
    if not is_registered(settings):
        print("glts is not registered in %s" % SETTINGS)
        return 0
    kept = []
    for entry in entries(settings):
        hooks = [h for h in entry.get("hooks", []) if h.get("command") != HOOK]
        if hooks:
            kept.append({**entry, "hooks": hooks})
    if kept:
        settings["hooks"]["MessageDisplay"] = kept
    else:
        settings.get("hooks", {}).pop("MessageDisplay", None)
        if not settings.get("hooks"):
            settings.pop("hooks", None)
    save_settings(settings)
    trace_off()
    print("glts removed from %s" % SETTINGS)
    print("restart Claude Code for it to take effect")
    return 0


def trace_on():
    os.makedirs(STATE_DIR, exist_ok=True)
    open(TRACE_FLAG, "w").close()


def trace_off():
    try:
        os.unlink(TRACE_FLAG)
    except OSError:
        pass


def cmd_status():
    settings = load_settings()
    on = is_registered(settings)
    print("%sbridge%s   %s" % (BOLD, RESET, "on" if on else "off"))
    print("%shook%s     %s" % (BOLD, RESET, HOOK))
    print("%ssettings%s %s" % (BOLD, RESET, SETTINGS))
    print("%strace%s    %s" % (BOLD, RESET, "on" if os.path.exists(TRACE_FLAG) else "off"))
    try:
        size = os.path.getsize(TRACE_LOG)
        print("%slog%s      %s (%d bytes)" % (BOLD, RESET, TRACE_LOG, size))
    except OSError:
        print("%slog%s      %s (empty)" % (BOLD, RESET, TRACE_LOG))
    return 0


def render(record):
    stamp = record.get("time", "")
    tag = "final" if record.get("final") else "#%s" % record.get("index")
    print("%s%s %s%s" % (DIM, stamp, tag, RESET))
    for line in (record.get("in") or "").splitlines() or [""]:
        print("  %s<-%s %s" % (CYAN, RESET, line))
    for line in (record.get("out") or "").splitlines() or [""]:
        print("  %s->%s %s" % (GREEN, RESET, line))
    print()


def stop_watching(signum, frame):
    raise KeyboardInterrupt


def cmd_watch(keep):
    trace_on()
    os.makedirs(STATE_DIR, exist_ok=True)
    # Keep the feed live when it is piped into another command or a file.
    sys.stdout.reconfigure(line_buffering=True)
    # Treat a termination signal like Ctrl+C so the trace is switched off too.
    signal.signal(signal.SIGTERM, stop_watching)
    print("%swatching glts%s  %s" % (BOLD, RESET, TRACE_LOG))
    print("%severy assistant message is shown twice: <- as sent, -> as displayed%s" % (DIM, RESET))
    print("%sCtrl+C to stop%s\n" % (DIM, RESET))
    try:
        position = os.path.getsize(TRACE_LOG)
    except OSError:
        position = 0
    try:
        while True:
            try:
                size = os.path.getsize(TRACE_LOG)
            except OSError:
                time.sleep(0.3)
                continue
            if size < position:  # the log was rotated away
                position = 0
            if size > position:
                with open(TRACE_LOG) as fh:
                    fh.seek(position)
                    for line in fh:
                        line = line.strip()
                        if not line:
                            continue
                        try:
                            render(json.loads(line))
                        except ValueError:
                            pass
                    position = fh.tell()
            time.sleep(0.2)
    except KeyboardInterrupt:
        if not keep:
            trace_off()
            print("\nstopped, trace switched off")
        else:
            print("\nstopped, trace left on")
    return 0


def cmd_try(text):
    print(_hook.convert_delta(text, "glts-try", True))
    return 0


def read_input(path):
    if path:
        with open(path, encoding="utf-8") as fh:
            return fh.read()
    return sys.stdin.read()


def cmd_kartuli(path):
    """Latin in, Georgian out. The way to write a Georgian file cheaply."""
    sys.stdout.write(_hook.convert_delta(read_input(path), "glts-kartuli", True))
    return 0


def cmd_latin(path, exact=False):
    """Georgian in, Latin out. Reads stdin when no file is named."""
    sys.stdout.write(_hook.to_latin(read_input(path), exact))
    return 0


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    command, rest = argv[0], argv[1:]
    if command == "on":
        return cmd_on()
    if command == "off":
        return cmd_off()
    if command == "status":
        return cmd_status()
    if command == "watch":
        return cmd_watch("--keep" in rest)
    if command == "try":
        return cmd_try(" ".join(rest))
    if command == "latin":
        files = [a for a in rest if not a.startswith("-")]
        return cmd_latin(files[0] if files else None, "--exact" in rest)
    if command == "kartuli":
        return cmd_kartuli(rest[0] if rest else None)
    print("unknown command: %s" % command, file=sys.stderr)
    print(__doc__.strip(), file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
